{
  "_comment": "Automated checks for ACTIVE_OBJECTIVE.md (rebuilt 2026-06-01 per John: 'delete it and build what I told you'). Bookie's brain is now Claude (bookie.brain), not a hardcoded rules engine; code is only the QBO connector. Criteria below verify the rebuild and that no scripted-brain modules remain. Paths use ${OPENHARNESS_ROOT} and ${BOOKIE_ROOT}. Run `harness goal verify` after every commit.",
  "criteria": [
    {
      "id": "bookie-brain-exists",
      "type": "file_exists",
      "description": "Bookie's Claude-driven brain module exists",
      "path": "${BOOKIE_ROOT}/src/bookie/brain.py"
    },
    {
      "id": "bookie-brain-uses-claude",
      "type": "grep_in_file",
      "description": "Bookie's brain runs Claude (the `claude` CLI) — judgment is the LLM, not code",
      "path": "${BOOKIE_ROOT}/src/bookie/brain.py",
      "needle": "claude"
    },
    {
      "id": "bookie-brain-has-no-keyword-rules",
      "type": "not_grep_in_file",
      "description": "The brain contains no hardcoded COA_PATTERNS keyword table",
      "path": "${BOOKIE_ROOT}/src/bookie/brain.py",
      "needle": "COA_PATTERNS"
    },
    {
      "id": "bookie-qbo-connector-exists",
      "type": "file_exists",
      "description": "The QBO connector (the only plumbing kept) exists",
      "path": "${BOOKIE_ROOT}/src/bookie/qbo.py"
    },
    {
      "id": "bookie-no-categorizer",
      "type": "not_file_exists",
      "description": "The scripted categorizer was deleted",
      "path": "${BOOKIE_ROOT}/src/bookie/categorizer.py"
    },
    {
      "id": "bookie-no-coa-rules",
      "type": "not_file_exists",
      "description": "The hardcoded chart-of-accounts keyword rules were deleted",
      "path": "${BOOKIE_ROOT}/src/bookie/coa.py"
    },
    {
      "id": "bookie-no-cleanup-rules",
      "type": "not_file_exists",
      "description": "The scripted cleanup rules were deleted",
      "path": "${BOOKIE_ROOT}/src/bookie/cleanup.py"
    },
    {
      "id": "bookie-no-browser-stub",
      "type": "not_file_exists",
      "description": "The unused browser-automation stub was deleted",
      "path": "${BOOKIE_ROOT}/src/bookie/browser.py"
    },
    {
      "id": "bookie-no-plaid-module",
      "type": "not_file_exists",
      "description": "No Plaid module (stripped requirement)",
      "path": "${BOOKIE_ROOT}/src/bookie/plaid_feed.py"
    },
    {
      "id": "bookie-full-test-suite-passes",
      "type": "command_succeeds",
      "description": "Bookie's full test suite passes",
      "command": "cd ${BOOKIE_ROOT} && python3 -m pytest tests/ -q",
      "timeout_seconds": 120
    },
    {
      "id": "bookie-brain-has-tests",
      "type": "file_exists",
      "description": "The Claude brain has behavioral tests (injected runner)",
      "path": "${BOOKIE_ROOT}/tests/test_brain.py"
    },
    {
      "id": "bookie-qbo-has-tests",
      "type": "file_exists",
      "description": "The QBO connector has tests",
      "path": "${BOOKIE_ROOT}/tests/test_qbo.py"
    },
    {
      "id": "bookie-working-tree-clean",
      "type": "command_succeeds",
      "description": "Bookie working tree has no uncommitted tracked changes",
      "command": "cd ${BOOKIE_ROOT} && test -z \"$(git status --porcelain | grep -v '^??')\"",
      "timeout_seconds": 10
    },
    {
      "id": "bookie-laptop-matches-origin",
      "type": "command_succeeds",
      "description": "Bookie laptop HEAD matches origin/master",
      "command": "cd ${BOOKIE_ROOT} && git fetch -q origin && test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/master)\"",
      "timeout_seconds": 15
    },
    {
      "id": "openharness-working-tree-clean",
      "type": "command_succeeds",
      "description": "OpenHarness working tree has no uncommitted tracked changes",
      "command": "cd ${OPENHARNESS_ROOT} && test -z \"$(git status --porcelain | grep -v '^??')\"",
      "timeout_seconds": 10
    },
    {
      "id": "openharness-laptop-matches-origin",
      "type": "command_succeeds",
      "description": "OpenHarness laptop HEAD matches origin/master",
      "command": "cd ${OPENHARNESS_ROOT} && git fetch -q origin && test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/master)\"",
      "timeout_seconds": 15
    },
    {
      "id": "claude-code-hooks-installed",
      "type": "file_exists",
      "description": "Claude Code hooks settings.json installed (laptop)",
      "path": "/home/john/repos/.claude/settings.json"
    },
    {
      "id": "anti-lie-hook-exists",
      "type": "file_exists",
      "description": "The anti-lie attribution guard hook exists",
      "path": "/home/john/repos/.claude/hooks/stop-no-lying.sh"
    }
  ]
}
