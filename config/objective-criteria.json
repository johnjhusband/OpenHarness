{
  "_comment": "Automated checks for the ACTIVE_OBJECTIVE.md. Paths use ${OPENHARNESS_ROOT} (workspace root) and ${BOOKIE_ROOT} (Bookie repo root, derived from the employee registry) so the same file works on laptop and VPS. After every commit and before declaring any work done, run `harness goal verify`. If anything is red, the immediate next action is to make it green.",
  "criteria": [
    {
      "id": "openharness-has-memory-module",
      "type": "file_exists",
      "description": "OpenHarness memory module exists",
      "path": "${OPENHARNESS_ROOT}/src/openharness/memory.py"
    },
    {
      "id": "openharness-has-reflection-module",
      "type": "file_exists",
      "description": "OpenHarness reflection module exists",
      "path": "${OPENHARNESS_ROOT}/src/openharness/reflection.py"
    },
    {
      "id": "openharness-has-cron-module",
      "type": "file_exists",
      "description": "OpenHarness cron module exists",
      "path": "${OPENHARNESS_ROOT}/src/openharness/cron.py"
    },
    {
      "id": "openharness-has-hooks-module",
      "type": "file_exists",
      "description": "OpenHarness hooks module exists",
      "path": "${OPENHARNESS_ROOT}/src/openharness/hooks.py"
    },
    {
      "id": "openharness-has-skills-dispatch",
      "type": "file_exists",
      "description": "OpenHarness skills dispatch module exists",
      "path": "${OPENHARNESS_ROOT}/src/openharness/skills.py"
    },
    {
      "id": "openharness-has-goal-module",
      "type": "file_exists",
      "description": "OpenHarness goal verification module exists",
      "path": "${OPENHARNESS_ROOT}/src/openharness/goal.py"
    },
    {
      "id": "bookie-uses-openharness-memory",
      "type": "grep_in_file",
      "description": "Bookie tick uses openharness.memory (not just memory_appends)",
      "path": "${BOOKIE_ROOT}/src/bookie/__init__.py",
      "needle": "from openharness import memory"
    },
    {
      "id": "bookie-uses-openharness-skills",
      "type": "grep_in_file",
      "description": "Bookie tick invokes openharness.skills.run dispatch",
      "path": "${BOOKIE_ROOT}/src/bookie/__init__.py",
      "needle": "from openharness import skills"
    },
    {
      "id": "bookie-has-bank-rule-detector",
      "type": "grep_in_file",
      "description": "Bookie has the self-improvement pattern detector for Bank Rule candidates",
      "path": "${BOOKIE_ROOT}/src/bookie/__init__.py",
      "needle": "_detect_bank_rule_candidates"
    },
    {
      "id": "bookie-no-plaid-imports",
      "type": "not_grep_in_file",
      "description": "Bookie tick has no Plaid references (stripped requirement)",
      "path": "${BOOKIE_ROOT}/src/bookie/__init__.py",
      "needle": "plaid"
    },
    {
      "id": "bookie-no-plaid-module",
      "type": "not_file_exists",
      "description": "Bookie plaid_feed.py was deleted (stripped requirement)",
      "path": "${BOOKIE_ROOT}/src/bookie/plaid_feed.py"
    },
    {
      "id": "bookie-no-anomaly-module",
      "type": "not_file_exists",
      "description": "Bookie anomaly.py was deleted (stripped invented scope)",
      "path": "${BOOKIE_ROOT}/src/bookie/anomaly.py"
    },
    {
      "id": "bookie-no-close-module",
      "type": "not_file_exists",
      "description": "Bookie close.py was deleted (stripped invented scope)",
      "path": "${BOOKIE_ROOT}/src/bookie/close.py"
    },
    {
      "id": "bookie-browser-surface-exists",
      "type": "file_exists",
      "description": "Bookie browser-automation surface scaffolded",
      "path": "${BOOKIE_ROOT}/src/bookie/browser.py"
    },
    {
      "id": "bookie-categorizer-tests-pass",
      "type": "command_succeeds",
      "description": "Bookie categorizer tests pass",
      "command": "python3 -m pytest ${BOOKIE_ROOT}/tests/test_categorizer.py -q",
      "timeout_seconds": 60
    },
    {
      "id": "harness-verify-clean",
      "type": "command_succeeds",
      "description": "OpenHarness workspace integrity check passes",
      "command": "${OPENHARNESS_ROOT}/bin/harness verify",
      "timeout_seconds": 30
    },
    {
      "id": "bookie-employee-registered",
      "type": "grep_in_file",
      "description": "Bookie is registered as an employee in OpenHarness",
      "path": "${OPENHARNESS_ROOT}/config/employees.json",
      "needle": "\"bookie\""
    },
    {
      "id": "bookie-skill-discoverable",
      "type": "file_exists",
      "description": "Bookie's categorize-transaction skill is in the discoverable skills dir",
      "path": "${OPENHARNESS_ROOT}/employees/bookie/skills/categorize-transaction/SKILL.md"
    },
    {
      "id": "bookie-requirements-doc-exists",
      "type": "file_exists",
      "description": "Bookie requirements.md exists (traceable scope)",
      "path": "${BOOKIE_ROOT}/prd/requirements.md"
    },
    {
      "id": "weekly-reflection-cron-installed",
      "type": "grep_in_file",
      "description": "Weekly reflection cron job is registered for Bookie",
      "path": "${OPENHARNESS_ROOT}/config/cron-jobs.json",
      "needle": "harness:reflect:bookie"
    },
    {
      "id": "claude-code-hooks-installed",
      "type": "file_exists",
      "description": "Claude Code hooks settings.json installed (laptop only)",
      "path": "/home/john/repos/.claude/settings.json"
    },
    {
      "id": "hook-session-init-exists",
      "type": "file_exists",
      "description": "SessionStart hook script exists (laptop only)",
      "path": "/home/john/repos/.claude/hooks/session-init.sh"
    },
    {
      "id": "hook-prompt-submit-exists",
      "type": "file_exists",
      "description": "UserPromptSubmit hook script exists (laptop only)",
      "path": "/home/john/repos/.claude/hooks/prompt-submit.sh"
    },
    {
      "id": "hook-post-bash-commit-exists",
      "type": "file_exists",
      "description": "PostToolUse Bash hook for git commit exists (laptop only)",
      "path": "/home/john/repos/.claude/hooks/post-bash-commit.sh"
    },
    {
      "id": "hook-stop-check-exists",
      "type": "file_exists",
      "description": "Stop hook script exists (laptop only)",
      "path": "/home/john/repos/.claude/hooks/stop-check.sh"
    },
    {
      "id": "preamble-command-defined",
      "type": "grep_in_file",
      "description": "harness preamble subcommand is defined (the context injected by hooks)",
      "path": "${OPENHARNESS_ROOT}/src/openharness/cli.py",
      "needle": "def _cmd_preamble"
    },
    {
      "id": "openharness-working-tree-clean",
      "type": "command_succeeds",
      "description": "OpenHarness working tree has no uncommitted tracked changes",
      "command": "cd ${OPENHARNESS_ROOT} && test -z \"$(git status --porcelain | grep -v '^??')\"",
      "timeout_seconds": 10
    },
    {
      "id": "openharness-laptop-matches-origin",
      "type": "command_succeeds",
      "description": "OpenHarness laptop HEAD matches origin/master",
      "command": "cd ${OPENHARNESS_ROOT} && git fetch -q origin && test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/master)\"",
      "timeout_seconds": 15
    },
    {
      "id": "bookie-working-tree-clean",
      "type": "command_succeeds",
      "description": "Bookie working tree has no uncommitted tracked changes",
      "command": "cd ${BOOKIE_ROOT} && test -z \"$(git status --porcelain | grep -v '^??')\"",
      "timeout_seconds": 10
    },
    {
      "id": "bookie-laptop-matches-origin",
      "type": "command_succeeds",
      "description": "Bookie laptop HEAD matches origin/master",
      "command": "cd ${BOOKIE_ROOT} && git fetch -q origin && test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/master)\"",
      "timeout_seconds": 15
    },
    {
      "id": "chat-db-not-tracked",
      "type": "command_succeeds",
      "description": "state/chat.db is gitignored (was causing chronic VPS-laptop merge conflicts)",
      "command": "cd ${OPENHARNESS_ROOT} && test -z \"$(git ls-files state/chat.db)\"",
      "timeout_seconds": 5
    },
    {
      "id": "tick-cursor-not-tracked",
      "type": "command_succeeds",
      "description": "state/last-tick-cursor.json is gitignored",
      "command": "cd ${OPENHARNESS_ROOT} && test -z \"$(git ls-files state/last-tick-cursor.json)\"",
      "timeout_seconds": 5
    }
  ]
}
